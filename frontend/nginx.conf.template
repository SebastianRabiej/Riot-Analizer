# Rendered from this template at container start by the nginx image's envsubst
# step. Substituted: ${PORT} ${BACKEND_URL} ${BACKEND_HOST} ${NGINX_RESOLVER}
# (see NGINX_ENVSUBST_FILTER in the Dockerfile). nginx's own $variables survive.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolve the upstream at REQUEST time (not at startup) so nginx always
    # boots and keeps serving the static site even if the backend URL is empty
    # or the backend is momentarily down.
    #   docker-compose : NGINX_RESOLVER=127.0.0.11 (Docker's embedded DNS)
    #   Railway (public backend) : NGINX_RESOLVER=1.1.1.1
    resolver ${NGINX_RESOLVER} valid=30s ipv6=on;

    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              "${BACKEND_HOST}";
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_name "${BACKEND_HOST}";
        proxy_ssl_server_name on;
        proxy_read_timeout 60s;
    }

    location /actuator/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              "${BACKEND_HOST}";
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_name "${BACKEND_HOST}";
        proxy_ssl_server_name on;
    }

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
