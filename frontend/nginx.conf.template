# Rendered from this template at container start by the nginx image's
# envsubst step (/docker-entrypoint.d/20-envsubst-on-templates.sh).
# Only ${PORT}, ${BACKEND_URL} and ${BACKEND_HOST} are substituted
# (NGINX_ENVSUBST_FILTER in the Dockerfile); nginx's own $host, $uri,
# $scheme, $remote_addr, $proxy_add_x_forwarded_for are left untouched.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxy the backend REST API.
    #   docker-compose : BACKEND_URL=http://backend:8080          BACKEND_HOST=backend
    #   Railway        : BACKEND_URL=https://<backend>.up.railway.app  BACKEND_HOST=<backend>.up.railway.app
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              ${BACKEND_HOST};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_read_timeout 60s;
    }

    # Actuator (health, etc.) also proxied to the backend.
    location /actuator/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              ${BACKEND_HOST};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
    }

    # SPA fallback: unknown paths return index.html for the client-side router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
