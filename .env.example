# ---- Riot Analizer environment ----
# Copy this file to ".env" and fill in the values:
#   cp .env.example .env
#
# REQUIRED: your Riot developer API key. Without it the backend cannot call
# the Riot API and no data is fetched. Get one at https://developer.riotgames.com/
# NOTE: development keys EXPIRE EVERY 24 HOURS — refresh this value daily.
RIOT_API_KEY=your-dev-key-here

# ---- Admin login ----
# One admin account can see and manage tracking (tracked + discovered players,
# Track/Untrack). Everyone else only gets the public stats pages.
# Only a BCrypt HASH of the password is configured — never the password itself.
# Generate one with:   make admin-hash
# Keep the SINGLE QUOTES: the hash contains '$' characters that docker compose
# would otherwise try to expand. Leave empty to disable admin login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''
# Optional: idle timeout of the admin session (Spring duration, default 8h) and
# brute-force guard (N failed logins per window locks login for that window).
# ADMIN_SESSION_TIMEOUT=8h
# ADMIN_MAX_FAILED_LOGINS=10
# ADMIN_LOCKOUT_MINUTES=15
# Session/CSRF cookies are marked Secure (HTTPS only) by default. Local docker
# compose runs over plain http, so it sets this to false; keep true in prod.
# APP_COOKIE_SECURE=false

# ---- PostgreSQL ----
POSTGRES_USER=riot
POSTGRES_PASSWORD=riot
POSTGRES_DB=riotanalizer

# ---- App configuration ----
# Start of the current season, epoch milliseconds. Only matches with
# gameCreation >= this value are counted toward stats. Default = 2025-01-09.
RIOT_CURRENT_SEASON_START_EPOCH_MS=1736380800000

# Optional: a player to auto-track on startup, as "gameName#tagLine"
# (EUNE region). Leave blank to add players via the UI search instead.
RIOT_INITIAL_PLAYER=

# How often the scheduler wakes up to look for DUE players (ms). Each player
# has its own next check time based on how recently they played, so a tick
# with nobody due costs no Riot calls.
RIOT_SCHEDULER_TICK_MS=15000

# Early checks: while the Riot budget has spare room, players are checked
# BEFORE their regular next check time (soonest first, tracked before
# discovered). A player is checked early at most once per MIN_GAP, and only
# while MIN_FREE_RATIO of the long (2-minute) window is unused.
RIOT_EARLY_CHECK_ENABLED=true
RIOT_EARLY_CHECK_TRACKED_MIN_GAP_MS=120000
RIOT_EARLY_CHECK_DISCOVERED_MIN_GAP_MS=1800000
RIOT_EARLY_CHECK_TRACKED_MIN_FREE_RATIO=0.4
RIOT_EARLY_CHECK_DISCOVERED_MIN_FREE_RATIO=0.6

# Discovery: players met in tracked players' matches are fetched in the
# background with spare rate-limit budget. MAX_DEPTH 1 = only those players,
# N = N hops, -1 = unbounded, 0 = off. MAX_PLAYERS 0 = no cap.
RIOT_DISCOVERY_MAX_DEPTH=1
RIOT_DISCOVERY_MAX_PLAYERS=0

# Match backfill: the current season is pulled in batches of at most
# FETCH_BATCH_SIZE new matches per check, walking newest -> oldest and skipping
# anything already stored. Once the season is complete, each check is a single
# "anything new since the newest match?" call.
# MATCH_PAGE_SIZE is capped at 100 by the Riot API. MAX_HISTORY_MATCHES bounds
# how deep into history to page (raise for very long histories).
# NOTE: stats/vs views still count only the current season; this stores it all.
RIOT_MATCH_PAGE_SIZE=100
RIOT_FETCH_BATCH_SIZE=25
RIOT_MAX_HISTORY_MATCHES=2000

# Backend log level for the app's own logs (com.riotanalizer).
# INFO shows fetch start/progress/summary and each stored match.
# Set to DEBUG to also log every Riot API call and rate-limit wait.
LOG_LEVEL=INFO
